@using Microsoft.AspNetCore.Identity
@using NoryMusicLMS_VS.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-page="/Profile" title="Profile">My profile</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
    </li>
    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Start Learning Free</a>
    </li>
}
</ul>
