@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.Quizzes.CreateModel
@{
    ViewData["Title"] = "Create Quiz";
}

<h1>Create quiz</h1>
<p class="text-muted">Attach the quiz to a specific lesson, choose its learning mode, then add questions.</p>

<form method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-8">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" placeholder="e.g. Note Values Check" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Type" class="form-label">Quiz type</label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<QuizType>()" class="form-select"></select>
        <div class="form-text">Theory or Ear Training.</div>
    </div>

    <div class="col-12">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="col-12">
        <label asp-for="Input.LessonId" class="form-label">Lesson</label>
        <select asp-for="Input.LessonId" asp-items="ViewBag.LessonId" class="form-select">
            <option value="">-- Select lesson --</option>
        </select>
        <span asp-validation-for="Input.LessonId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.Image" class="form-label">Quiz cover image</label>
        <input asp-for="Input.Image" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control" />
        <div class="form-text">Max 2 MB; stored in database.</div>
        <span asp-validation-for="Input.Image" class="text-danger"></span>
    </div>

    <div class="col-md-6 form-check align-self-end ms-2">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label asp-for="Input.IsActive" class="form-check-label">Publish quiz</label>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Create quiz</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}