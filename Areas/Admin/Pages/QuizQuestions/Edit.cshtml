@page "{id:int}"
@model NoryMusicLMS_VS.Areas.Admin.Pages.QuizQuestions.EditModel
@{ViewData["Title"]="Edit Quiz Question";}
<h1>Edit quiz question</h1><p class="text-muted">Select the quiz first. Then choose the question type and configure the matching answer fields.</p><form method="post" enctype="multipart/form-data" class="row g-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-12"><label asp-for="Input.QuizId" class="form-label">Quiz</label><select asp-for="Input.QuizId" asp-items="ViewBag.QuizId" class="form-select"><option value="">-- Select course → lesson → quiz --</option></select><span asp-validation-for="Input.QuizId" class="text-danger"></span></div><div class="col-md-9"><label asp-for="Input.QuestionText" class="form-label">Question</label><textarea asp-for="Input.QuestionText" class="form-control" rows="3"></textarea><span asp-validation-for="Input.QuestionText" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Input.Type" class="form-label">Question type</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<QuestionType>()" class="form-select" id="questionType"></select></div><div class="col-md-3"><label asp-for="Input.Points" class="form-label">Points</label><input asp-for="Input.Points" type="number" min="1" class="form-control"/></div><div class="col-md-3"><label asp-for="Input.OrderIndex" class="form-label">Order</label><input asp-for="Input.OrderIndex" type="number" min="1" class="form-control"/></div>
<div id="choiceFields" class="col-12"><div class="row g-2"><div class="col-md-6"><label asp-for="Input.Option1" class="form-label">Option 1</label><input asp-for="Input.Option1" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Option2" class="form-label">Option 2</label><input asp-for="Input.Option2" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Option3" class="form-label">Option 3</label><input asp-for="Input.Option3" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Option4" class="form-label">Option 4</label><input asp-for="Input.Option4" class="form-control"/></div></div><div class="mt-2"><label asp-for="Input.CorrectOptionNumber" class="form-label">Correct option number</label><input asp-for="Input.CorrectOptionNumber" type="number" min="1" max="4" class="form-control" style="max-width:180px"/></div></div>
<div id="textAnswerFields" class="col-12"><label asp-for="Input.CorrectAnswerText" class="form-label">Expected answer</label><input asp-for="Input.CorrectAnswerText" class="form-control" placeholder="e.g. C, quarter note, Perfect 5th"/><span asp-validation-for="Input.CorrectAnswerText" class="text-danger"></span></div>
<div id="audioFields" class="col-12"><div class="row g-2"><div class="col-md-6"><label asp-for="Input.Audio" class="form-label">Upload MP3</label><input asp-for="Input.Audio" type="file" accept=".mp3,audio/mpeg" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.AudioUrl" class="form-label">Audio URL</label><input asp-for="Input.AudioUrl" class="form-control" placeholder="https://.../note.mp3"/></div><div class="col-md-6"><label asp-for="Input.ToneSequence" class="form-label">Tone sequence (Hz)</label><input asp-for="Input.ToneSequence" class="form-control" placeholder="261.63,392.00"/></div></div><div class="form-text">Audio Identification can use an uploaded MP3, an audio URL, or browser-synthesized tones.</div></div>
<div class="col-md-6"><label asp-for="Input.Audio" class="form-label">Replace MP3 audio</label><input asp-for="Input.Audio" type="file" accept=".mp3,audio/mpeg" class="form-control"/>@if(!string.IsNullOrWhiteSpace(Model.CurrentAudioUrl)){<audio controls class="w-100 mb-2"><source src="@Model.CurrentAudioUrl" type="audio/mpeg"></audio>}<div class="form-check mt-2"><input asp-for="Input.RemoveAudio" class="form-check-input"/><label asp-for="Input.RemoveAudio" class="form-check-label">Remove current audio</label></div><div class="form-text">Upload an MP3 for guitar ear-training questions.</div></div><div class="col-md-6"><label asp-for="Input.Image" class="form-label">Question image</label>@if(!string.IsNullOrWhiteSpace(Model.CurrentImageUrl)){<img src="@Model.CurrentImageUrl" class="img-thumbnail d-block mb-2" style="max-height:130px"/>}<input asp-for="Input.Image" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control"/><div class="form-text">Use this for staff notation, note values, chord diagrams or visual exercises. Max 2 MB; stored in database.</div></div><div class="col-12"><button class="btn btn-primary">Save question</button> <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>function sync(){const t=document.getElementById('questionType').value;document.getElementById('choiceFields').style.display=(t==='0'||t==='1')?'block':'none';document.getElementById('textAnswerFields').style.display=(t==='2'||t==='3')?'block':'none';document.getElementById('audioFields').style.display=t==='3'?'block':'none';if(t==='1'){document.querySelector('[name="Input.Option1"]').value='True';document.querySelector('[name="Input.Option2"]').value='False';}}document.addEventListener('DOMContentLoaded',()=>{sync();document.getElementById('questionType').addEventListener('change',sync);});</script>}
