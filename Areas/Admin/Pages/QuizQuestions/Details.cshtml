@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.QuizQuestions.DetailsModel
@{
    ViewData["Title"] = "Quiz Question Details";
}

<h1>Quiz Question Details</h1>

<div class="row">
    <div class="col-md-8">
        <h2>@Model.QuizQuestion.QuestionText</h2>
        <p><strong>Quiz:</strong> @Model.QuizQuestion.Quiz.Title (@Model.QuizQuestion.Quiz.Lesson.Course.Title)</p>
        <p><strong>Type:</strong> @Model.QuizQuestion.Type</p>
        <p><strong>Points:</strong> @Model.QuizQuestion.Points</p>
        <p><strong>Order:</strong> @Model.QuizQuestion.OrderIndex</p>

        @switch (Model.QuizQuestion.Type)
        {
            case QuestionType.MultipleChoice:
            case QuestionType.TrueFalse:
                {
                    var options = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.QuizQuestion.OptionsJson ?? "[]");
                    <div class="mt-4">
                        <h3>Options</h3>
                        <ol class="list-group list-group-numbered">
                            @for (int i = 0; i < options?.Count; i++)
                            {
                                <li class="list-group-item">
                                    @options[i]
                                    @if (Model.QuizQuestion.CorrectAnswerIndex == i + 1)
                                    {
                                        <span class="badge bg-success ms-2">Correct</span>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                    break;
                }
            case QuestionType.FillInBlank:
                {
                    <div class="alert alert-info mt-3">
                        <strong>Correct Answer:</strong> @Model.QuizQuestion.CorrectAnswerText
                    </div>
                    break;
                }
            case QuestionType.AudioIdentification:
                {
                    <div class="mt-4">
                        <h3>Audio Identification</h3>
                        <p><strong>Correct Note:</strong> @Model.QuizQuestion.CorrectAnswerText</p>
                        @if (!string.IsNullOrEmpty(Model.QuizQuestion.AudioUrl))
                        {
                            <div class="mb-3">
                                <audio controls class="w-100">
                                    <source src="@Model.QuizQuestion.AudioUrl" type="audio/mpeg">
                                    Your browser does not support the audio element.
                                </audio>
                            </div>
                        }
                    </div>
                    break;
                }
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h4>Actions</h4>
            </div>
            <div class="card-body">
                <a asp-page="./Edit" asp-route-id="@Model.QuizQuestion.Id" class="btn btn-primary w-100 mb-2">Edit Question</a>
                <a asp-page="./Index" class="btn btn-outline-secondary w-100">Back to List</a>
            </div>
        </div>
    </div>
</div>