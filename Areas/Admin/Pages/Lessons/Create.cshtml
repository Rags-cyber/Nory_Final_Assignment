@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.Lessons.CreateModel
@{
    ViewData["Title"] = "Create Lesson";
}

<h1>Create lesson</h1>

<form method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-8">
        <label asp-for="Input.CourseId" class="form-label">Course</label>
        <select asp-for="Input.CourseId" class="form-control"></select>
    </div>

    <div class="col-12">
        <label asp-for="Input.Title" class="form-label">Title</label>
        <input asp-for="Input.Title" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="Input.VideoUrl" class="form-label">Video URL</label>
        <input asp-for="Input.VideoUrl" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="Input.Image" class="form-label">Lesson image</label>
        <input asp-for="Input.Image" type="file" class="form-control" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Create lesson</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}