@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.Lessons.CreateModel
@{
    ViewData["Title"] = "Create Lesson";
}

<h1>Create Lesson</h1>

<form method="post">
    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Course</label>
        <div class="col-sm-10">
            <select class="form-select" asp-for="Lesson.CourseId" asp-items="ViewBag.CourseId">
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="Lesson.CourseId" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Title</label>
        <div class="col-sm-10">
            <input class="form-control" asp-for="Lesson.Title" />
            <span asp-validation-for="Lesson.Title" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Content</label>
        <div class="col-sm-10">
            <textarea class="form-control" asp-for="Lesson.Content" rows="5"></textarea>
            <span asp-validation-for="Lesson.Content" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Order Index</label>
        <div class="col-sm-10">
            <input class="form-control" type="number" asp-for="Lesson.OrderIndex" />
            <span asp-validation-for="Lesson.OrderIndex" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Video URL (YouTube/Vimeo)</label>
        <div class="col-sm-10">
            <input class="form-control" asp-for="Lesson.VideoUrl" />
            <span asp-validation-for="Lesson.VideoUrl" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Audio URL (MP3)</label>
        <div class="col-sm-10">
            <input class="form-control" asp-for="Lesson.AudioUrl" />
            <span asp-validation-for="Lesson.AudioUrl" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-2 col-form-label">Notation URL (PDF/Image)</label>
        <div class="col-sm-10">
            <input class="form-control" asp-for="Lesson.NotationUrl" />
            <span asp-validation-for="Lesson.NotationUrl" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}