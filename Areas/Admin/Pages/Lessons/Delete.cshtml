@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.Lessons.DeleteModel
@{
    ViewData["Title"] = "Delete Lesson";
}

<h1>Delete Lesson</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this lesson?</h4>
    <p>This action cannot be undone. Associated quizzes, questions, and resources will also be removed.</p>
</div>

<div class="card col-md-6 mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Lesson.Title</h5>
        <p class="card-text mb-1">@Model.Lesson.Content</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Course</dt>
            <dd class="col-sm-8">@Model.Lesson.Course.Title</dd>
            <dt class="col-sm-4">Order</dt>
            <dd class="col-sm-8">@Model.Lesson.OrderIndex</dd>
        </dl>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Lesson.Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>