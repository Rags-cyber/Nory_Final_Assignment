@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.Resources.CreateModel
@{
    ViewData["Title"] = "Upload Resource";
}

<h1>Upload New Resource</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Resource.Title" class="control-label"></label>
        <input asp-for="Resource.Title" class="form-control" />
        <span asp-validation-for="Resource.Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Resource.Description" class="control-label"></label>
        <textarea asp-for="Resource.Description" class="form-control"></textarea>
        <span asp-validation-for="Resource.Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Resource.Type" class="control-label"></label>
        <select asp-for="Resource.Type" class="form-select" asp-items="Html.GetEnumSelectList<NoryMusicLMS_VS.Models.ResourceType>()"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Resource.Url" class="control-label">File URL / Path</label>
        <input asp-for="Resource.Url" class="form-control" placeholder="/uploads/lesson1-sheet.pdf or https://..." />
        <span asp-validation-for="Resource.Url" class="text-danger"></span>
        <small class="form-text text-muted">Link to an external file, or a path under wwwroot (e.g. /uploads/file.pdf) if you've uploaded it there.</small>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Resource.LessonId" class="control-label">Lesson</label>
        <select asp-for="Resource.LessonId" class="form-select" asp-items="ViewBag.LessonId"></select>
    </div>

    <button type="submit" class="btn btn-primary">Upload</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
