@page
@model NoryMusicLMS_VS.Areas.Admin.Pages.Courses.CreateModel
@{ ViewData["Title"] = "Create Course"; }
<h1>Create course</h1><p class="text-muted">Build the course that instructors and students will use.</p>
<form method="post" enctype="multipart/form-data" class="row g-3">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-8"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" placeholder="e.g. Music Theory Fundamentals"/><span asp-validation-for="Input.Title" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Input.InstructorId" class="form-label">Instructor</label><select asp-for="Input.InstructorId" asp-items="ViewBag.InstructorId" class="form-select"><option value="">-- Select instructor --</option></select><span asp-validation-for="Input.InstructorId" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="What students will learn, prerequisites and outcomes"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Input.StartDate" class="form-label"></label><input asp-for="Input.StartDate" type="date" class="form-control"/></div>
<div class="col-md-4"><label asp-for="Input.EndDate" class="form-label"></label><input asp-for="Input.EndDate" type="date" class="form-control"/><span asp-validation-for="Input.EndDate" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Input.Image" class="form-label">Course thumbnail</label><input asp-for="Input.Image" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control"/><div class="form-text">Max 2 MB. Stored in the database.</div><span asp-validation-for="Input.Image" class="text-danger"></span></div>
<div class="col-12 form-check ms-2"><input asp-for="Input.IsActive" class="form-check-input"/><label asp-for="Input.IsActive" class="form-check-label">Publish course</label></div>
<div class="col-12"><button class="btn btn-primary">Create course</button> <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
