@page "{id:int}"
@model NoryMusicLMS_VS.Areas.Admin.Pages.Courses.EditModel
@{ViewData["Title"]="Edit Course";}
<h1>Edit course</h1>
<form method="post" enctype="multipart/form-data" class="row g-3">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-8"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control"/><span asp-validation-for="Input.Title" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Input.InstructorId" class="form-label">Instructor</label><select asp-for="Input.InstructorId" asp-items="ViewBag.InstructorId" class="form-select"></select><span asp-validation-for="Input.InstructorId" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="4"></textarea></div>
<div class="col-md-4"><label asp-for="Input.StartDate" class="form-label"></label><input asp-for="Input.StartDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.EndDate" class="form-label"></label><input asp-for="Input.EndDate" type="date" class="form-control"/><span asp-validation-for="Input.EndDate" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Input.Image" class="form-label">Course thumbnail</label>@if(!string.IsNullOrWhiteSpace(Model.CurrentImageUrl)){<img src="@Model.CurrentImageUrl" class="img-thumbnail d-block mb-2" style="max-height:120px"/>}<input asp-for="Input.Image" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control"/><div class="form-text">Max 2 MB; stored in database.</div>@if(!string.IsNullOrWhiteSpace(Model.CurrentImageUrl)){<div class="form-check mt-2"><input asp-for="Input.RemoveImage" class="form-check-input"/><label asp-for="Input.RemoveImage" class="form-check-label">Remove image</label></div>}<span asp-validation-for="Input.Image" class="text-danger"></span></div>
<div class="col-12 form-check ms-2"><input asp-for="Input.IsActive" class="form-check-input"/><label asp-for="Input.IsActive" class="form-check-label">Published</label></div><div class="col-12"><button class="btn btn-primary">Save changes</button> <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
