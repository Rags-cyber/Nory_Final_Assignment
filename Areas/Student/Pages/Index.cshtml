@page
@model NoryMusicLMS_VS.Areas.Student.Pages.IndexModel
@{
    ViewData["Title"] = "My Learning";
}

<section class="nory-hero-panel mb-4">
    <p class="nory-eyebrow mb-2">YOUR MUSIC LEARNING STUDIO</p>
    <div class="row align-items-end g-3">
        <div class="col-lg-8">
            <h1 class="mb-2">Welcome back, @Model.CurrentUser.FirstName.</h1>
            <p class="text-muted mb-0">Pick up your course, train your ear, or spend a few minutes with your guitar.</p>
        </div>
        <div class="col-lg-4 d-flex flex-wrap gap-2 justify-content-lg-end">
            <a asp-page="/BrowseCourses" class="btn btn-primary"><i class="bi bi-collection me-1"></i>Explore courses</a>
            <a asp-page="/Quizzes" asp-route-type="@QuizType.EarTraining" class="btn btn-outline-info"><i class="bi bi-soundwave me-1"></i>Train your ear</a>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="nory-stat"><div class="value">@Model.Enrollments.Count</div><div class="label">Courses joined</div></div></div>
    <div class="col-6 col-lg-3"><div class="nory-stat"><div class="value">@Model.Enrollments.Count(e => e.Status == EnrollmentStatus.Completed)</div><div class="label">Courses completed</div></div></div>
    <div class="col-6 col-lg-3"><div class="nory-stat"><div class="value">@Model.RecentAttempts.Count(a => a.IsPassed)</div><div class="label">Recent passes</div></div></div>
    <div class="col-6 col-lg-3"><div class="nory-stat"><div class="value">@Model.Awards.Count</div><div class="label">Recent awards</div></div></div>
</div>

<div class="d-flex align-items-end justify-content-between gap-3 mb-3">
    <div><p class="nory-eyebrow mb-1">KEEP YOUR MOMENTUM</p><h2 class="h3 mb-0">My courses</h2></div>
    <a asp-page="/BrowseCourses" class="btn btn-sm btn-outline-primary">Browse all courses <i class="bi bi-arrow-right ms-1"></i></a>
</div>

@if (!Model.Enrollments.Any())
{
    <section class="card mb-4"><div class="card-body p-4 p-lg-5 text-center">
        <span class="action-icon mb-3" aria-hidden="true"><i class="bi bi-music-note-list"></i></span>
        <h3 class="h4">Choose your first learning path</h3>
        <p class="text-muted mx-auto" style="max-width: 36rem">Start with music theory, explore guitar chords, then build confidence through quizzes and listening practice.</p>
        <a asp-page="/BrowseCourses" class="btn btn-primary">Find a course</a>
    </div></section>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
    @foreach (var enrollment in Model.Enrollments)
    {
        var description = enrollment.Course.Description ?? string.Empty;
        <div class="col"><article class="card h-100 overflow-hidden"><img src="@(MediaFallbacks.CourseImage(enrollment.Course))" class="w-100" style="height:180px;object-fit:cover" alt="@enrollment.Course.Title course cover" /><div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div><span class="nory-pill">@(enrollment.Status == EnrollmentStatus.Completed ? "COMPLETED" : "LEARNING PATH")</span><h3 class="h4 mt-2 mb-1">@enrollment.Course.Title</h3></div>
                <i class="bi bi-music-note-list fs-3 text-warning" aria-hidden="true"></i>
            </div>
            <p class="text-muted">@(description.Length > 150 ? description[..150] + "…" : description)</p>
            <div class="nory-progress-label"><span>Lesson progress</span><strong>@enrollment.ProgressPercentage%</strong></div>
            <div class="progress my-2" role="progressbar" aria-label="@enrollment.Course.Title completion" aria-valuenow="@enrollment.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @enrollment.ProgressPercentage%"></div>
            </div>
            <div class="d-flex align-items-center justify-content-between mt-3 gap-2">
                <small class="text-muted">Joined @enrollment.EnrolledAt.ToString("MMM d, yyyy")</small>
                <a asp-page="./CourseDetails" asp-route-id="@enrollment.CourseId" class="btn btn-sm btn-primary">Continue <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div></article></div>
    }
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <section class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Recent practice</h2><a asp-page="/Quizzes" class="small">All quizzes</a></div>
            <div class="card-body">
                @if (Model.RecentAttempts.Count == 0)
                {
                    <p class="text-muted mb-0">Your quiz attempts and scores will appear here. Try a short theory or listening quiz to begin.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                    @foreach (var attempt in Model.RecentAttempts)
                    {
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3">
                            <div><strong>@attempt.Quiz.Title</strong><div class="small text-muted">@attempt.Quiz.Type · @attempt.CompletedAt?.ToString("MMM d, yyyy")</div></div>
                            <span class="badge @(attempt.IsPassed ? "bg-success" : "bg-secondary")">@attempt.ScorePercentage% · @(attempt.IsPassed ? "Passed" : "Try again")</span>
                        </div>
                    }
                    </div>
                }
            </div>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Awards</h2><i class="bi bi-award text-warning fs-5"></i></div>
            <div class="card-body">
                @if (Model.Awards.Count == 0)
                {
                    <p class="text-muted mb-0">Complete a course or pass a quiz to earn your first award.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                    @foreach (var award in Model.Awards)
                    {
                        <li class="list-group-item px-0"><strong><i class="bi bi-patch-check text-warning me-1"></i>@award.Title</strong><div class="small text-muted">@award.Description · @award.EarnedAt.ToString("MMM d, yyyy")</div></li>
                    }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>
