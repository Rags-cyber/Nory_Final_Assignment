@page
@model NoryMusicLMS_VS.Areas.Student.Pages.Quiz.ResultModel
@{
    ViewData["Title"] = "Quiz Results";
}

<p class="nory-eyebrow mb-1">PRACTICE REVIEW</p>
<h1 class="mb-4">Your quiz results</h1>

<section class="nory-hero-panel mb-4">
    <div class="row align-items-center g-4">
        <div class="col-md-8">
            <span class="nory-pill">@Model.Quiz.Type</span>
            <h2 class="h3 mt-2 mb-1">@Model.Quiz.Title</h2>
            <p class="text-muted mb-0">@Model.Quiz.Lesson.Course.Title · @Model.Quiz.Lesson.Title</p>
            <p class="small text-muted mt-2 mb-0">Completed @Model.Attempt.CompletedAt?.ToString("MMM d, yyyy 'at' h:mm tt")</p>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="display-4 fw-bold">@Model.Attempt.ScorePercentage%</div>
            <span class="badge @(Model.Attempt.IsPassed ? "bg-success" : "bg-warning") fs-6">@(Model.Attempt.IsPassed ? "Passed · badge earned" : "Keep practising")</span>
        </div>
    </div>
</section>

<div class="row g-3">
    <div class="col-lg-8">
        <section class="card">
            <div class="card-header"><h2 class="h5 mb-0">Answer review</h2></div>
            <div class="card-body">
                @if (Model.Answers == null || !Model.Answers.Any())
                {
                    <p class="text-muted mb-0">No answers were recorded for this attempt.</p>
                }
                else
                {
                    <div class="vstack gap-2">
                    @for (int i = 0; i < Model.Answers.Count; i++)
                    {
                        var answer = Model.Answers[i];
                        var question = answer.Question;
                        <article class="list-group-item rounded p-3">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2"><strong>Question @(i + 1)</strong><span class="badge @(answer.IsCorrect ? "bg-success" : "bg-danger")">@(answer.IsCorrect ? "Correct" : "Incorrect")</span></div>
                            <p>@question.QuestionText</p>
                            @switch (question.Type)
                            {
                                case QuestionType.MultipleChoice:
                                case QuestionType.TrueFalse:
                                {
                                    var options = System.Text.Json.JsonSerializer.Deserialize<List<string>>(question.OptionsJson ?? "[]");
                                    <p class="small mb-1"><strong>Your answer:</strong> @(answer.SelectedAnswerIndex.HasValue && answer.SelectedAnswerIndex.Value >= 0 && answer.SelectedAnswerIndex.Value < (options?.Count ?? 0) ? options![answer.SelectedAnswerIndex.Value] : "Not answered")</p>
                                    <p class="small mb-0"><strong>Correct answer:</strong> @(question.CorrectAnswerIndex.HasValue && question.CorrectAnswerIndex.Value >= 0 && question.CorrectAnswerIndex.Value < (options?.Count ?? 0) ? options![question.CorrectAnswerIndex.Value] : "Not set")</p>
                                    break;
                                }
                                case QuestionType.FillInBlank:
                                case QuestionType.AudioIdentification:
                                {
                                    <p class="small mb-1"><strong>Your answer:</strong> @(string.IsNullOrWhiteSpace(answer.SelectedAnswer) ? "Not answered" : answer.SelectedAnswer)</p>
                                    <p class="small mb-0"><strong>Correct answer:</strong> @question.CorrectAnswerText</p>
                                    break;
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(answer.Feedback))
                            {
                                <div class="small text-muted mt-2">@answer.Feedback</div>
                            }
                        </article>
                    }
                    </div>
                }
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="card"><div class="card-header"><h2 class="h5 mb-0">Keep going</h2></div><div class="card-body d-grid gap-2">
            <a asp-area="Student" asp-page="/Quiz/Take" asp-route-quizId="@Model.Quiz.Id" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Retake quiz</a>
            <a asp-area="Student" asp-page="/LessonView" asp-route-lessonId="@Model.Quiz.Lesson.Id" class="btn btn-outline-secondary">Review lesson</a>
            <a asp-area="Student" asp-page="/Index" class="btn btn-outline-secondary">Back to my learning</a>
        </div></section>
    </div>
</div>
