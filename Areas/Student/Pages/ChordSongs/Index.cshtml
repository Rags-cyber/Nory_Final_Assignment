@page
@model NoryMusicLMS_VS.Areas.Student.Pages.ChordSongs.IndexModel
@{
    ViewData["Title"] = "Song Chords";
}
<p class="nory-eyebrow mb-1">Song library</p>
<h1>Guitar chords</h1>
<p class="text-muted">Section-by-section chord guidance for practice. Lyrics are not reproduced; use the linked reference for lyric alignment.</p>

<form method="get" class="row g-2 mb-4">
    <div class="col-sm-8 col-md-6"><input asp-for="Search" class="form-control" placeholder="Search song, artist, or instrument" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button></div>
    @if (!string.IsNullOrWhiteSpace(Model.Search)) { <div class="col-auto"><a asp-page="./Index" class="btn btn-link">Clear</a></div> }
</form>

@if (Model.Songs.Count == 0)
{
    <div class="alert alert-info">No chord sheets found. Try another search.</div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
    @foreach (var song in Model.Songs)
    {
        <div class="col">
            <article class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2">
                        <div><h2 class="h4 mb-1">@song.Title</h2><p class="text-muted">@song.Artist</p></div>
                        <span class="badge bg-secondary align-self-start">@song.Instrument</span>
                    </div>
                    
                    @if (!string.IsNullOrWhiteSpace(song.ImageUrl))
                    {
                        <div class="text-center mb-3">
                            <img src="@song.ImageUrl" alt="Chord diagram: @song.Title" class="img-fluid rounded" style="max-height:200px; object-fit:contain;" />
                        </div>
                    }
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (song.Key is not null) { <span class="badge bg-light text-dark">Key: @song.Key</span> }
                        @if (song.CapoFret.HasValue) { <span class="badge bg-light text-dark">Capo: @song.CapoFret</span> }
                        @if (song.TempoBpm.HasValue) { <span class="badge bg-warning text-dark"><i class="bi bi-speedometer2 me-1"></i>Starting tempo @song.TempoBpm BPM</span> }
                    </div>
                    <div class="rounded p-3 bg-body-tertiary mb-3">
                        <h3 class="h6">Section chord progression</h3>
                        @foreach (var line in song.ChordMap.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div class="mb-2 font-monospace"><strong>@line</strong></div>
                        }
                    </div>
                    <p class="small text-muted">Chord sequence shown without lyrics. For exact lyric placement and the full user-contributed chart, see the attributed reference.</p>
                    @if (!string.IsNullOrWhiteSpace(song.StrummingPattern)) { <p><strong>Strumming:</strong> @song.StrummingPattern</p> }
                    @if (song.TempoBpm.HasValue)
                    {
                        <div class="nory-tempo-control mt-3 p-3 rounded">
                            <div class="d-flex justify-content-between align-items-center mb-2"><label class="form-label mb-0" for="tempo-@song.Id">Practice tempo</label><output class="nory-tempo-value" for="tempo-@song.Id">@song.TempoBpm BPM</output></div>
                            <input id="tempo-@song.Id" type="range" class="form-range nory-tempo-slider" min="40" max="220" step="1" value="@song.TempoBpm" aria-label="Adjust practice tempo" />
                            <div class="d-flex justify-content-between small text-muted"><span>40 BPM</span><span>220 BPM</span></div>
                            <div class="d-flex align-items-center gap-3 mt-2"><button type="button" class="btn btn-sm btn-primary nory-metronome" data-bpm="@song.TempoBpm"><i class="bi bi-play-fill me-1"></i>Start metronome</button><span class="small text-muted nory-tempo-status" aria-live="polite">Adjust the tempo to suit your practice.</span></div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(song.AttributionUrl))
                    {
                        <a href="@song.AttributionUrl" target="_blank" rel="noopener noreferrer" class="small ms-2">Chord reference</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(song.TempoNote)) { <div class="small text-muted mt-2">@song.TempoNote</div> }
                </div>
            </article>
        </div>
    }
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll('.nory-tempo-control').forEach(control => {
        const slider = control.querySelector('.nory-tempo-slider');
        const output = control.querySelector('.nory-tempo-value');
        const status = control.querySelector('.nory-tempo-status');
        const button = control.querySelector('.nory-metronome');
        let timer = null;
        let audio = null;

        const tempo = () => Number(slider.value);
        const renderTempo = () => {
            output.value = `${tempo()} BPM`;
            output.textContent = `${tempo()} BPM`;
            button.dataset.bpm = tempo();
            if (timer) {
                clearInterval(timer);
                timer = setInterval(tick, 60000 / tempo());
                status.textContent = `Metronome running at ${tempo()} BPM.`;
            }
        };
        const tick = () => {
            if (!audio) return;
            const now = audio.currentTime;
            const oscillator = audio.createOscillator();
            const gain = audio.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.value = 880;
            gain.gain.setValueAtTime(0.16, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.055);
            oscillator.connect(gain);
            gain.connect(audio.destination);
            oscillator.start(now);
            oscillator.stop(now + 0.06);
        };

        slider.addEventListener('input', renderTempo);
        button.addEventListener('click', async () => {
            if (timer) {
                clearInterval(timer);
                timer = null;
                button.innerHTML = '<i class="bi bi-play-fill me-1"></i>Start metronome';
                status.textContent = 'Metronome stopped.';
                return;
            }
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) {
                status.textContent = 'Audio playback is not supported in this browser.';
                return;
            }
            audio ??= new AudioContext();
            await audio.resume();
            tick();
            timer = setInterval(tick, 60000 / tempo());
            button.innerHTML = '<i class="bi bi-stop-fill me-1"></i>Stop metronome';
            status.textContent = `Metronome running at ${tempo()} BPM.`;
        });
    });
</script>
}
