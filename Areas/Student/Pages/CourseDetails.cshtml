@page "{id:int}"
@model NoryMusicLMS_VS.Areas.Student.Pages.CourseDetailsModel
@{
    ViewData["Title"] = Model.Course?.Title ?? "Course Details";
}

<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">My Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Course.Title</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-md-8">
            @if (!string.IsNullOrWhiteSpace(Model.Course.ImageUrl))
            {
                <img src="@Model.Course.ImageUrl" class="img-fluid rounded mb-3" alt="@Model.Course.Title" />
            }
            else
            {
                <img src="/images/music-staff.svg" class="img-fluid rounded mb-3" alt="Music notation illustration" />
            }
            <h2>@Model.Course.Title</h2>
            <p class="lead text-muted">@Model.Course.Description</p>
            <p>
                <i class="bi bi-person"></i> <strong>Instructor:</strong> @Model.Course.Instructor.FirstName @Model.Course.Instructor.LastName<br />
                <i class="bi bi-calendar"></i> <strong>Started:</strong> @Model.Course.StartDate.ToString("MMM dd, yyyy")
            </p>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">Your Progress</h5>
                    <div class="progress my-3" style="height: 20px;">
                        <div class="progress-bar" role="progressbar" 
                             style="width: @Model.Enrollment.ProgressPercentage%;" 
                             aria-valuenow="@Model.Enrollment.ProgressPercentage" 
                             aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <span class="badge @(Model.Enrollment.Status == EnrollmentStatus.Completed ? "bg-info" : "bg-success")">
                        @Model.Enrollment.Status
                    </span>
                </div>
            </div>
        </div>
    </div>

    <h3>Course Lessons</h3>
    <hr />

    @if (Model.Lessons == null || !Model.Lessons.Any())
    {
        <div class="alert alert-info">
            No lessons have been published for this course yet. Check back soon!
        </div>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var lesson in Model.Lessons)
            {
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                    <div>
                        <h5 class="mb-1">Lesson @lesson.OrderIndex: @lesson.Title</h5>
                        <div class="text-muted small">
                            @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                            {
                                <span class="badge bg-danger me-1">Video</span>
                            }
                            @if (!string.IsNullOrEmpty(lesson.AudioUrl))
                            {
                                <span class="badge bg-info me-1">Audio</span>
                            }
                            @if (!string.IsNullOrEmpty(lesson.NotationUrl))
                            {
                                <span class="badge bg-secondary me-1">Sheet Music</span>
                            }
                        </div>
                    </div>
                    <a asp-page="./LessonView" asp-route-lessonId="@lesson.Id" class="btn btn-primary">
                        Start Lesson
                    </a>
                </div>
            }
        </div>
    }

    <a asp-page="./Index" class="btn btn-outline-secondary">← Back to Dashboard</a>
</div>
