@page
@model NoryMusicLMS_VS.Areas.Student.Pages.LessonViewModel
@{
    ViewData["Title"] = $"Lesson: {Model.Lesson.Title}";
    var contentLines = (Model.Lesson.Content ?? "")
        .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);
    var lessonImage = Model.Lesson.Title switch
    {
        "The Staff, Clefs, and Note Duration" => "/images/music-staff.svg",
        "Steps, Accidentals, and Key Signatures" => "/images/music-keys.svg",
        "The Major Scale" => "/images/music-scale.svg",
        "Intervals and Ear Training" => "/images/music-intervals.svg",
        "Triads and Basic Chords" => "/images/music-triads.svg",
        "Chord Progressions and Harmonic Function" => "/images/music-harmony.svg",
        "Song Form and Accompaniment" => "/images/music-form.svg",
        _ => "/images/music-staff.svg"
    };
}

<p class="nory-eyebrow mb-1">@Model.Course.Title &middot; Lesson @Model.CurrentLessonIndex of @Model.TotalLessons</p>
<h1 class="mb-3">@Model.Lesson.Title</h1>

<div class="progress mb-4">
    <div class="progress-bar" role="progressbar" style="width: @Model.Enrollment.ProgressPercentage%" aria-valuenow="@Model.Enrollment.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <img src="@lessonImage" class="w-100 rounded-top" alt="Music theory illustration for @Model.Lesson.Title" />
            <div class="card-body">
                <h3>Lesson Content</h3>
                <div class="lesson-content">
                    @foreach (var line in contentLines)
                    {
                        if (line.StartsWith("## ", StringComparison.Ordinal))
                        {
                            <h4 class="mt-4">@line[3..]</h4>
                        }
                        else if (line.StartsWith("- ", StringComparison.Ordinal))
                        {
                            <p class="mb-2"><i class="bi bi-check2-circle text-info me-2"></i>@line[2..]</p>
                        }
                        else if (line.StartsWith("Example: ", StringComparison.Ordinal))
                        {
                            <div class="alert alert-info py-2"><strong>Worked example:</strong> @line[9..]</div>
                        }
                        else if (line.StartsWith("Practice: ", StringComparison.Ordinal))
                        {
                            <div class="p-3 mb-3 rounded nory-practice-prompt"><strong>Try it:</strong> @line[10..]</div>
                        }
                        else
                        {
                            <p>@line</p>
                        }
                    }
                </div>
                <div class="mt-3 p-3 rounded bg-body-tertiary">
                    <strong>Source and license</strong>
                    <p class="small text-muted mb-0">
                        Lesson summary adapted for Nory from Robert Hutchinson, <em>Music Theory for the 21st-Century Classroom</em>,
                        University of Puget Sound (2017; draft dated August 23, 2019), relevant chapter cited above.
                        The source states it is available under the GNU Free Documentation License 1.2 or later.
                        Nory's explanations and practice prompts are newly written summaries.
                    </p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Lesson.VideoUrl))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Video Lesson</h3>
                </div>
                <div class="card-body">
                    <div class="ratio ratio-16x9">
                        <iframe src="@Model.Lesson.VideoUrl" title="Lesson Video" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Lesson.AudioUrl))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Audio Lesson</h3>
                </div>
                <div class="card-body">
                    <audio controls class="w-100">
                        <source src="@Model.Lesson.AudioUrl" type="audio/mpeg">
                        Your browser does not support the audio element.
                    </audio>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Lesson.NotationUrl))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Notation/Sheet Music</h3>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <a href="@Model.Lesson.NotationUrl" target="_blank" class="btn btn-outline-primary">
                            <i class="bi bi-file-earmark-me"></i> View Notation
                        </a>
                    </div>
                </div>
            </div>
        }
        @if (Model.Resources.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>Additional Resources</h3>
                </div>
                <div class="card-body">
                    @foreach (var resource in Model.Resources)
                    {
                        var host = Uri.TryCreate(resource.Url, UriKind.Absolute, out var uri) ? uri.Host.Replace("www.", "") : "Uploaded file";
                        <a href="@resource.Url" target="_blank" rel="noopener" class="nory-resource-link">
                            <div>
                                <div><strong>@resource.Title</strong> <span class="nory-pill ms-1">@resource.Type</span></div>
                                @if (!string.IsNullOrEmpty(resource.Description))
                                {
                                    <div class="text-muted small">@resource.Description</div>
                                }
                                <div class="source">@host</div>
                            </div>
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3>Lesson Actions</h3>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="MarkComplete">
                    <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
                    <button type="submit" class="btn btn-primary w-100 mb-2" @(Model.Enrollment.Status != EnrollmentStatus.Active ? "disabled" : null)>
                        @(Model.Enrollment.Status == EnrollmentStatus.Completed ? "Course Completed" : "Mark Lesson Complete")
                    </button>
                </form>
                @if (Model.PreviousLessonId.HasValue)
                {
                    <a asp-page="./LessonView" asp-route-lessonId="@Model.PreviousLessonId" class="btn btn-outline-secondary w-100 mb-2">Previous lesson</a>
                }
                @if (Model.NextLessonId.HasValue)
                {
                    <a asp-page="./LessonView" asp-route-lessonId="@Model.NextLessonId" class="btn btn-outline-secondary w-100 mb-2">Next lesson</a>
                }

                @if (Model.Quizzes.Any())
                {
                    <div class="mt-3">
                        <h5>Quizzes for this Lesson</h5>
                        @foreach (var quiz in Model.Quizzes)
                        {
                            <div class="mb-2">
                                <a asp-area="Student" asp-page="/Quiz/Take" asp-route-quizId="@quiz.Id" class="btn btn-outline-info w-100">
                                    @quiz.Title (@quiz.Type)
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info mt-3">No quizzes for this lesson yet.</div>
                }

                <a asp-page="./CourseDetails" asp-route-id="@Model.Course.Id" class="btn btn-outline-secondary w-100 mt-3">
                    Back to Course
                </a>
            </div>
        </div>
    </div>
</div>

