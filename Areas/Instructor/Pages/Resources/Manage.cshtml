@page "{lessonId:int}"
@model NoryMusicLMS_VS.Areas.Instructor.Pages.Resources.ManageModel
@{
    ViewData["Title"] = "Lesson Resources";
}
<p class="nory-eyebrow mb-1">@Model.Lesson.Course.Title · @Model.Lesson.Title</p>
<h1>Lesson resources</h1>
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }

<h2 class="h4 mt-4">Current resources</h2>
@if (Model.Lesson.Resources.Count == 0)
{
    <p class="text-muted">No resources have been added to this lesson.</p>
}
else
{
    <div class="list-group mb-4">
    @foreach (var resource in Model.Lesson.Resources)
    {
        <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
            <div>
                <a href="@resource.Url" target="_blank" rel="noopener noreferrer">@resource.Title</a>
                <span class="badge bg-secondary ms-1">@resource.Type</span>
                @if (!string.IsNullOrWhiteSpace(resource.Description)) { <div class="small text-muted">@resource.Description</div> }
            </div>
            <form method="post" asp-page-handler="Delete" asp-route-lessonId="@Model.Lesson.Id" asp-route-resourceId="@resource.Id">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
            </form>
        </div>
    }
    </div>
}

<section class="card">
    <div class="card-header"><h2 class="h5 mb-0">Add a resource link</h2></div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="2"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div>
            <div class="row">
                <div class="col-md-5 mb-3"><label asp-for="Input.Type" class="form-label"></label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<ResourceType>()" class="form-select"></select></div>
                <div class="col-md-7 mb-3"><label asp-for="Input.Url" class="form-label">Resource URL</label><input asp-for="Input.Url" class="form-control" placeholder="https://..." /><span asp-validation-for="Input.Url" class="text-danger"></span></div>
            </div>
            <button type="submit" class="btn btn-primary">Add resource</button>
            <a asp-area="Instructor" asp-page="/Courses/Details" asp-route-id="@Model.Lesson.CourseId" class="btn btn-outline-secondary">Back to course</a>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
