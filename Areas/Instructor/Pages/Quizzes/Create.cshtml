@page
@model NoryMusicLMS_VS.Areas.Instructor.Pages.Quizzes.CreateModel
@{
    ViewData["Title"] = "Create Quiz";
}
<h1>Create quiz</h1>
<p class="text-muted">Lesson: @Model.LessonTitle</p>
<div class="row"><div class="col-md-7 col-lg-6">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.Type" class="form-label"></label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<QuizType>()" class="form-select"></select></div>
        <button type="submit" class="btn btn-primary">Create quiz</button>
        <a asp-page="/Courses/Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
