@page "{id:int}"
@model NoryMusicLMS_VS.Areas.Instructor.Pages.Quizzes.EditModel
@{
    ViewData["Title"] = "Edit Quiz";
}

<h1>Edit quiz</h1>
<p class="text-muted">Lesson: @Model.LessonTitle</p>

<form method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-8">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Type" class="form-label">Quiz type</label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<QuizType>()" class="form-select"></select>
    </div>

    <div class="col-12">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.Image" class="form-label">Quiz cover image</label>
        @if (!string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
        {
            <img src="@Model.CurrentImageUrl" class="img-thumbnail d-block mb-2" style="max-height:140px" />
        }
        <input asp-for="Input.Image" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control" />
        @if (!string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
        {
            <div class="form-check mt-2">
                <input asp-for="Input.RemoveImage" class="form-check-input" />
                <label asp-for="Input.RemoveImage" class="form-check-label">Remove image</label>
            </div>
        }
    </div>

    <div class="col-md-6 form-check align-self-end ms-2">
        <input asp-for="Input.IsActive" class="form-check-input" />
        <label asp-for="Input.IsActive" class="form-check-label">Published</label>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save quiz</button>
        <a asp-page="./Manage" asp-route-id="@Model.QuizId" class="btn btn-outline-secondary">Back to questions</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}