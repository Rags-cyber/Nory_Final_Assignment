@page
@model NoryMusicLMS_VS.Areas.Instructor.Pages.ChordSongs.IndexModel
@{
    ViewData["Title"] = "Song Chord Library";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><p class="nory-eyebrow mb-1">Instructor Console</p><h1 class="mb-0">Song chord library</h1></div>
    <a asp-page="Create" class="btn btn-primary">Add song</a>
</div>
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="table-responsive card">
    <table class="table table-hover mb-0">
        <thead><tr><th></th><th>Title</th><th>Artist</th><th>Instrument</th><th>Key</th><th></th></tr></thead>
        <tbody>
        @if (Model.Songs.Count == 0)
        {
            <tr><td colspan="6" class="p-3 text-muted">No songs yet. Add one for students to practice with.</td></tr>
        }
        @foreach (var song in Model.Songs)
        {
            <tr>
                <td style="width:56px">
                    @if (!string.IsNullOrWhiteSpace(song.ImageUrl))
                    {
                        <img src="@song.ImageUrl" alt="" class="rounded" style="width:48px;height:48px;object-fit:cover;" />
                    }
                </td>
                <td>@song.Title</td>
                <td>@song.Artist</td>
                <td>@song.Instrument</td>
                <td>@song.Key</td>
                <td class="text-nowrap"><a asp-page="Edit" asp-route-id="@song.Id" class="btn btn-sm btn-outline-secondary">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
