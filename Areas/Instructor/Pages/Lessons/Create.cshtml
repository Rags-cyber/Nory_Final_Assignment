@page
@model NoryMusicLMS_VS.Areas.Instructor.Pages.Lessons.CreateModel
@{
    ViewData["Title"] = "Create Lesson";
}
<h1>Add lesson</h1>
<p class="text-muted">Course: @Model.CourseTitle</p>
<div class="row"><div class="col-lg-8">
    <form method="post">
        <input asp-for="Input.CourseId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.Content" class="form-label">Lesson text/content</label><textarea asp-for="Input.Content" class="form-control" rows="7"></textarea><span asp-validation-for="Input.Content" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.OrderIndex" class="form-label">Lesson order</label><input asp-for="Input.OrderIndex" type="number" min="1" class="form-control" /><span asp-validation-for="Input.OrderIndex" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.VideoUrl" class="form-label">Video URL (optional)</label><input asp-for="Input.VideoUrl" class="form-control" /><span asp-validation-for="Input.VideoUrl" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.AudioUrl" class="form-label">Audio URL (optional)</label><input asp-for="Input.AudioUrl" class="form-control" /><span asp-validation-for="Input.AudioUrl" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.NotationUrl" class="form-label">Notation/sheet music URL (optional)</label><input asp-for="Input.NotationUrl" class="form-control" /><span asp-validation-for="Input.NotationUrl" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary">Create lesson</button>
        <a asp-page="/Courses/Details" asp-route-id="@Model.Input.CourseId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
